# Copia este archivo a .env y reemplaza con tu Client ID de Google Cloud
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
VITE_API_URL=http://localhost:3001/api

# backend/.env → GOOGLE_CLIENT_ID (mismo valor)
# Origenes en Google Console: http://localhost:5173 y http://127.0.0.1:5173
# Para pruebas con VS Code Tunnel, cambia VITE_API_URL por la URL publica del backend:
# VITE_API_URL=https://tu-tunel-del-puerto-3001/api
# Guia completa: ver LEEME.md
